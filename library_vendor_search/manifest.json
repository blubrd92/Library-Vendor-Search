{
  "manifest_version": 3,
  "name": "Library Vendor Search",
  "version": "7.11.1",
  "description": "Select text, right-click, and search Ingram, Brodart, Libraria, WorldCat, or your library catalog.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "vendor/browser-polyfill.min.js",
      "catalog.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://ipage.ingramcontent.com/*"
      ],
      "js": [
        "vendor/browser-polyfill.min.js",
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.bibz2.com/*"
      ],
      "js": [
        "vendor/browser-polyfill.min.js",
        "content-brodart.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.libraria.com/*"
      ],
      "js": [
        "vendor/browser-polyfill.min.js",
        "content-libraria.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "options.html",
    "default_title": "Library Vendor Search",
    "default_icon": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "library-vendor-search@your-library.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
